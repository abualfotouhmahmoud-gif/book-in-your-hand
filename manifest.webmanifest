{
  "name": "Book in Your Hand",
  "short_name": "Book in Hand",
  "description": "Read PDF books like a real book — right-to-left or left-to-right, with page curl, library, bookmarks, highlights and quotes.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#2e1e14",
  "theme_color": "#2e1e14",
  "lang": "en",
  "dir": "auto",
  "categories": ["books", "education", "productivity"],
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{"name": "pdf", "accept": ["application/pdf", ".pdf"]}]
    }
  }
}
